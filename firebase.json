{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": {
    "site": "chouchou-susukino",
    "public": ".",
    "headers": [
      {
        "source": "**/*.@(webp|png|jpg|jpeg|svg|woff|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=3600,must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=0,must-revalidate" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "firebase-debug.log",
      "firestore-debug.log",
      "storage-debug.log",
      "firestore.rules",
      "storage.rules",
      "functions/**",
      "tests/**",
      "**/*.md",
      "**/.*",
      "**/node_modules/**",
      "届出書/**",
      "*.xlsx",
      "*.heic",
      "*.HEIC",
      "*backup*",
      "*.save"
    ]
  }
}
